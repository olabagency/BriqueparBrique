{
  "rules": {
    ".read": true,
    ".write": true,
    "leaderboard": {
      ".indexOn": ["finalVal", "updatedAt"]
    },
    "sessions": {
      ".indexOn": ["updatedAt", "valuation"]
    },
    "notifications": {
      ".indexOn": ["ts"]
    },
    "presence": {
      ".indexOn": ["lastSeen"]
    }
  }
}
